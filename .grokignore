# .grokignore - files and directories Grok Build should ignore for context, indexing, and tools
# Similar to .gitignore but for the AI agent session

# Virtual environments
.venv/
venv/
env/
.conda/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data / DBs (project specific)
data/
*.db
*.sqlite
*.sqlite3

# Logs and temp
*.log
*.tmp
tmp/
temp/
logs/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Credentials and Secrets (Critical Prevention)
.env
.env.*
*.pem
*.key
id_rsa
secrets.json
credentials.xml
*.kdbx
*.ovpn
auth.json
secrets/

# Local Configuration & Cloud State
.aws/
.kube/
.gcp/
terraform.tfstate
terraform.tfstate.backup
*.tfvars

# Build Artifacts & Dependency Bloat (Efficiency Optimization)
node_modules/
__pycache__/
*.pyc
.next/
dist/
build/
vendor/
.venv/
*.log

# Agent Configuration (Prevent Recursive Poisoning)
.grok/hooks/
.grok/user-settings.json
docs/agents/private/
*.ai-memory.toml
.grok/sessions/
.grok/traces/
graphify-out/

# Database & Dumps (DPDP Act PII Protection)
*.sql
*.sqlite
*.db
*.dump

# Test / coverage artifacts
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Large generated or binary
*.zip
*.tar.gz
*.pdf
*.png
*.jpg
*.mp4
