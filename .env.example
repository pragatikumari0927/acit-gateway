# ACIT Gateway Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy to .env and customize for local development / testing:
#   cp .env.example .env
#
# SECURITY (per fastapi-security patterns for this defense-only gateway):
# - Use ONLY Razorpay TEST keys (rzp_test_*). Never put live keys here.
# - JWT_SECRET and API_KEY must be strong random values. Never log them.
# - All secrets are loaded via Pydantic Settings / environment.
# - .env is already ignored in .gitignore — do not commit real credentials.
# - The gateway uses cryptographic Mandate verification (ES256 in Vault), not
#   shared passwords for agents.

# Razorpay test-mode credentials (required for Money actions)
# Obtain from Razorpay Dashboard → Test mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay webhook secret for verifying incoming webhooks
# Generate a strong random value. Set in Razorpay Dashboard webhook config.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Strong secret for signing/verifying JWTs (agent identity in Vault)
# Must be >= 32 characters. Generate a secure value for real use.
JWT_SECRET=your_strong_jwt_secret_at_least_32_characters

# API key for service-to-service or operator authentication
# (e.g. protected audit export or admin endpoints)
API_KEY=your_api_key_for_service_to_service_auth

# Database connection (SQLite for this project)
# Path is relative; ensure the data/ directory exists.
DATABASE_URL=sqlite:///./data/acit.db

# Chaos engineering harness (C7) — injects failures into Razorpay adapter only
CHAOS_ENABLED=true
CHAOS_FAILURE_RATE=0.05

# MCP (Model Context Protocol) integration
# Set to true to enable MCP server functionality
MCP_ENABLED=false

# Logging verbosity
# Valid values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO